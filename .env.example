# Copiar como .env y completar con valores reales.
# Nunca commitear el archivo .env (ver .gitignore).

# --- Base de datos (ms-productos y ms-pedidos) ---
# DB_PORT es el puerto del host donde Docker publica PostgreSQL. Si ya
# tienes un PostgreSQL instalado en la maquina, el 5432 esta ocupado y las
# conexiones no llegan al contenedor: usa 5433 aqui y el mismo puerto en
# DB_URL.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/pedidos360
DB_USER=pedidos
# Obligatoria: no tiene valor por defecto, los servicios no arrancan sin ella.
DB_PASS=

# --- Seguridad JWT / Microsoft Entra ID (bff) ---
JWT_ISSUER=https://login.microsoftonline.com/baffd3de-6d87-4351-b113-0276e469ae8d/v2.0
JWT_JWKS_URI=https://login.microsoftonline.com/baffd3de-6d87-4351-b113-0276e469ae8d/discovery/v2.0/keys
JWT_AUDIENCE=b5c90e11-373c-4846-a4e0-5440187d52de

# --- URLs de microservicios (bff) ---
PRODUCTOS_URL=http://localhost:8081
PEDIDOS_URL=http://localhost:8082
