# Copiar como .env en CADA EC2 Kafka y ajustar NODO_ID / NODO_IP.
# Las IP son las privadas de la VPC (se conservan al detener/iniciar).

# 1, 2 o 3 segun la instancia (pedidos360-kafka-1, -2, -3)
NODO_ID=
# IP privada de ESTA instancia (debe coincidir con KAFKA_<NODO_ID>_IP)
NODO_IP=

KAFKA_1_IP=
KAFKA_2_IP=
KAFKA_3_IP=

# Memoria pensada para t3.small (2 GB): ~1,2 GB entre Zookeeper y broker.
ZOOKEEPER_HEAP_OPTS=-Xms128m -Xmx256m
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
